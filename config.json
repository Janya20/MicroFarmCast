{
  "input_paths": ["data/observations.csv"],
  "output_dir": "artifacts",
  "forecast_horizon_hours": 1,
  "timestamp_column": "timestamp",
  "location_id_column": "location_id",
  "latitude_column": "latitude",
  "longitude_column": "longitude",
  "target_columns": {
    "temperature": "temperature_c",
    "relative_humidity": "relative_humidity_pct",
    "rainfall": "rainfall_mm",
    "wind_speed": "wind_speed_m_s",
    "soil_moisture": "soil_moisture_m3_m3"
  },
  "feature_columns": [
    "latitude", "longitude", "elevation_m", "slope_deg", "aspect_deg",
    "temperature_c", "relative_humidity_pct", "rainfall_mm",
    "wind_speed_m_s", "soil_moisture_m3_m3",
    "air_pressure_hpa", "solar_radiation_w_m2"
  ],
  "lags_hours": [1, 2, 3, 6, 12, 24],
  "rolling_windows_hours": [3, 6, 24],
  "validation_fraction": 0.15,
  "test_fraction": 0.15,
  "rain_threshold_mm": 0.1,
  "xgboost": {
    "n_estimators": 300,
    "max_depth": 6,
    "learning_rate": 0.05,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "reg_lambda": 1.0,
    "random_state": 42,
    "n_jobs": -1
  }
}
